-  const exactRule = EXACT_ALIAS_RULES_BY_MODEL[normalizedModelID]
+  const exactRule = EXACT_ALIAS_RULES_BY_MODEL.get(normalizedModelID)
   if (exactRule) {
     return {
       requestedModelID: normalizedModelID,
