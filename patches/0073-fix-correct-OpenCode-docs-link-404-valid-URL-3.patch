--- a/README.md
+++ b/README.md
@@ -59,11 +59,11 @@ if command -v opencode &> /dev/null; then
     echo "OpenCode $(opencode --version) is installed"
 else
     echo "OpenCode is not installed. Please install it first."
-    echo "See: https://opencode.ai/docs/installation/"
