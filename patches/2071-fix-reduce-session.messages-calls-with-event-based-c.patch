+
+interface TranscriptCacheEntry {
+  baseEntries: string[]
+  tempPath: string | null
+  createdAt: number
+}
+
+const TRANSCRIPT_CACHE_TTL_MS = 5 * 60 * 1000 // 5 minutes
+
+const transcriptCache = new Map<string, TranscriptCacheEntry>()
