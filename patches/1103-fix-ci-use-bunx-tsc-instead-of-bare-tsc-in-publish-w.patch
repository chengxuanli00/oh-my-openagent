From 37d4aec4d068a002a2069393ff0e1b8418881ba2 Mon Sep 17 00:00:00 2001
From: justsisyphus <sisyphus-dev-ai@users.noreply.github.com>
Date: Fri, 16 Jan 2026 00:54:58 +0900
Subject: [PATCH 1103/5749] fix(ci): use bunx tsc instead of bare tsc in
 publish workflow

tsc is not in PATH when installed via bun - use bunx to run from node_modules/.bin
---
 .github/workflows/publish.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/publish.yml b/.github/workflows/publish.yml
index a2daa4a8..00ec3b46 100644
--- a/.github/workflows/publish.yml
+++ b/.github/workflows/publish.yml
@@ -109,7 +109,7 @@ jobs:
           echo "=== Running bun build (CLI) ==="
           bun build src/cli/index.ts --outdir dist/cli --target bun --format esm --external @ast-grep/napi
           echo "=== Running tsc ==="
-          tsc --emitDeclarationOnly
+          bunx tsc --emitDeclarationOnly
           echo "=== Running build:schema ==="
           bun run build:schema
 
-- 
2.39.2

