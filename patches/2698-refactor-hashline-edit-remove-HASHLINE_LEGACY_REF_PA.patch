-    const ref = "10:FF"
-
-    //#when
-    const result = parseLineRef(ref)
-
-    //#then
-    expect(result).toEqual({ line: 10, hash: "FF" })
-  })
-
-  it("legacy ref fails validation with hash mismatch, not parse error", () => {
