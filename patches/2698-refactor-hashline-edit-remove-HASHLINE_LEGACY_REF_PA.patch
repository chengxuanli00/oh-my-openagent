-    const lines = ["function hello() {"]
-
-    //#when / #then
-    expect(() => validateLineRef(lines, "1:ab")).toThrow(/>>>\s+1#[ZPMQVRWSNKTXJBYH]{2}\|/)
-  })
-
-  it("extracts legacy ref from content with markers", () => {
-    //#given
-    const ref = ">>> 42:ab|const x = 1"
-
-    //#when
-    const result = parseLineRef(ref)
