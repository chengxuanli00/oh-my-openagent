-        command: entry.command,
-        extensions: entry.extensions,
-        priority: entry.priority ?? 0,
-        env: entry.env,
-        initialization: entry.initialization,
-        source,
-      })
-      seen.add(id)
-    }
-  }
-
-  for (const [id, config] of Object.entries(BUILTIN_SERVERS)) {
