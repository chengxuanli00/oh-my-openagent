+         expect(entry.providers).toBeArray()
+         expect(entry.providers.length).toBeGreaterThan(0)
+       }
+     }
+   })
+})
 
-    // #when - checking each entry in fallbackChain
-    // #then - all have non-empty providers array
-    for (const req of allRequirements) {
