+
+    //#when
+    writeJsonAtomic(filePath, data)
+
+    //#then
+    expect(existsSync(filePath)).toBe(true)
+  })
+
+  test("writes data atomically", async () => {
+    //#given
+    const filePath = join(TEST_DIR_ABS, "atomic.json")
+    const data = { id: "test", value: 123 }
+
+    //#when
