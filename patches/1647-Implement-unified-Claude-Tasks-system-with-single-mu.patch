+      rmSync(TEST_DIR_ABS, { recursive: true, force: true })
+    }
+  })
+
+  afterEach(() => {
+    if (existsSync(TEST_DIR_ABS)) {
+      rmSync(TEST_DIR_ABS, { recursive: true, force: true })
+    }
+  })
+
+  test("creates directory if it does not exist", () => {
+    //#given
+    const filePath = join(TEST_DIR_ABS, "nested", "dir", "file.json")
