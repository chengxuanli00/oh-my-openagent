+        size: stat.size,
+        metadata,
+        body,
+      });
+      return { metadata, body };
+    } catch {
+      const rawContent = readRuleFileSync(filePath, "utf-8");
+      return parseRuleFrontmatter(rawContent);
+    }
+  }
 
