+function wrapWithNonInteractiveEnv(command: string): string {
+  const envPrefix = Object.entries(NON_INTERACTIVE_ENV)
+    .map(([key, value]) => `${key}=${value}`)
+    .join(" ")
+
+  return `${envPrefix} ${command} < /dev/null 2>&1 || ${envPrefix} ${command} 2>&1`
+}
