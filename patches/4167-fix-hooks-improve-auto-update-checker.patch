+) {
   const {
     showStartupToast = true,
     isSisyphusEnabled = false,
@@ -40,32 +70,32 @@ export function createAutoUpdateCheckerHook(ctx: PluginInput, options: AutoUpdat
       const props = event.properties as { info?: { parentID?: string } } | undefined
