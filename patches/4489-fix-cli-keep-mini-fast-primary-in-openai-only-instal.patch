 src/cli/model-fallback.test.ts                    |  6 +++---
 src/cli/openai-only-model-catalog.test.ts         |  4 ++--
 src/cli/openai-only-model-catalog.ts              |  4 ++--
 4 files changed, 11 insertions(+), 15 deletions(-)

