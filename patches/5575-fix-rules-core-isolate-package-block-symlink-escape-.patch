+  const effectiveBoundary = boundaryRoot ?? realDir;
+  if (!isPathWithinRoot(realDir, effectiveBoundary)) return;
   if (visited.has(realDir)) return;
   visited.add(realDir);
-  let entries;
+  let entries: Dirent<string>[] = [];
