From 9a9d9bd5a1a906dce9f6d456c55d2c54f2c7bce9 Mon Sep 17 00:00:00 2001
From: YeonGyu-Kim <code.yeon.gyu@gmail.com>
Date: Mon, 18 May 2026 20:55:59 +0900
Subject: [PATCH 5470/5749] fix(web): adapt build tooling

Ultraworked with [Sisyphus](https://github.com/code-yeongyu/oh-my-openagent)

Co-authored-by: Sisyphus <clio-agent@sisyphuslabs.ai>
---
 packages/web/eslint.config.mjs    | 13 ++++++++++++-
 packages/web/next.config.ts       |  3 ---
 packages/web/playwright.config.ts |  2 +-
 packages/web/wrangler.toml        |  2 +-
 4 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/packages/web/eslint.config.mjs b/packages/web/eslint.config.mjs
index 38013637..43359262 100644
--- a/packages/web/eslint.config.mjs
+++ b/packages/web/eslint.config.mjs
@@ -3,6 +3,17 @@ import nextPlugin from "@next/eslint-plugin-next"
 import prettier from "eslint-config-prettier/flat"
 import tseslint from "typescript-eslint"
 
+const nextCoreWebVitalsConfig = {
+  name: "next/core-web-vitals",
+  plugins: {
+    "@next/next": nextPlugin,
+  },
+  rules: {
+    ...nextPlugin.configs.recommended.rules,
+    ...nextPlugin.configs["core-web-vitals"].rules,
+  },
+}
+
 export default [
   {
     ignores: [".next/**", "out/**", "build/**", "next-env.d.ts"],
@@ -18,7 +29,7 @@ export default [
       },
     },
   },
-  nextPlugin.flatConfig.coreWebVitals,
+  nextCoreWebVitalsConfig,
   ...tseslint.configs.recommended,
   prettier,
   {
diff --git a/packages/web/next.config.ts b/packages/web/next.config.ts
index 63247f23..b81aaeed 100644
--- a/packages/web/next.config.ts
+++ b/packages/web/next.config.ts
@@ -6,9 +6,6 @@ const nextConfig: NextConfig = {
   turbopack: {
     root: __dirname,
   },
-  experimental: {
-    optimizeCss: true,
-  },
 }
 
 const withNextIntl = createNextIntlPlugin()
diff --git a/packages/web/playwright.config.ts b/packages/web/playwright.config.ts
index f0c765a9..195330f4 100644
--- a/packages/web/playwright.config.ts
+++ b/packages/web/playwright.config.ts
@@ -27,7 +27,7 @@ export default defineConfig({
   ],
 
   webServer: {
-    command: "next build && next start",
+    command: "bun --bun next build && bun --bun next start",
     url: "http://127.0.0.1:3000",
     reuseExistingServer: !process.env.CI,
     timeout: 180000,
diff --git a/packages/web/wrangler.toml b/packages/web/wrangler.toml
index b62b513e..be07cfaf 100644
--- a/packages/web/wrangler.toml
+++ b/packages/web/wrangler.toml
@@ -1,6 +1,6 @@
 main = ".open-next/worker.js"
 name = "oh-my-openagent-web"
-compatibility_date = "2025-03-25"
+compatibility_date = "2026-05-18"
 compatibility_flags = ["nodejs_compat"]
 workers_dev = false
 preview_urls = false
