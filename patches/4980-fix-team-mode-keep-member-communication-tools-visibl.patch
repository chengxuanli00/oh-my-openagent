+  test("allows team tools for team member prompt restrictions", () => {
+    // given
+    const teamMemberAgentName = "sisyphus-junior"
+
+    // when
+    const restrictions = getAgentToolRestrictions(teamMemberAgentName, { includeTeamToolDenylist: false })
