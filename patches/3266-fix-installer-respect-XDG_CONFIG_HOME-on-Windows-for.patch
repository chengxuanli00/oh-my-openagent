From f92c0931a3296c5723f61e88632db9cad3c3df3e Mon Sep 17 00:00:00 2001
From: acamq <179265037+acamq@users.noreply.github.com>
Date: Sun, 15 Mar 2026 08:26:41 -0600
Subject: [PATCH 3266/5749] fix(installer): respect XDG_CONFIG_HOME on Windows
 for CLI config dir

---
 src/shared/opencode-config-dir.ts | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/src/shared/opencode-config-dir.ts b/src/shared/opencode-config-dir.ts
index 6464a55e..620d561d 100644
--- a/src/shared/opencode-config-dir.ts
+++ b/src/shared/opencode-config-dir.ts
@@ -48,10 +48,6 @@ function getCliConfigDir(): string {
     return resolve(envConfigDir)
   }
 
-  if (process.platform === "win32") {
-    return join(homedir(), ".config", "opencode")
-  }
-
   const xdgConfig = process.env.XDG_CONFIG_HOME || join(homedir(), ".config")
   return join(xdgConfig, "opencode")
 }
