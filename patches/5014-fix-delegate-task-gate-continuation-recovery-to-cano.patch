     expect(removeTaskCalls.length).toBeGreaterThanOrEqual(1)
     expect(removeTaskCalls[0]).toBe("resume_sync_ses_test")
-    expect(result).toContain("Task continued and completed in")
-    expect(result).toContain("Result")
