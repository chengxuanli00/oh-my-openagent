From 57ec3a46ac2586eebb78527dc1190efcba1123c1 Mon Sep 17 00:00:00 2001
From: YeonGyu-Kim <code.yeon.gyu@gmail.com>
Date: Sat, 4 Apr 2026 14:47:15 +0900
Subject: [PATCH 3829/5749] fix(ci): use unquoted heredoc to allow env var
 expansion

---
 .github/workflows/ci.yml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index e55772f4..c3213b82 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -146,7 +146,7 @@ jobs:
             gh release edit next \
               --title "Upcoming Changes 🍿" \
               --notes-file - \
-              --draft <<'EOF'
+              --draft <<EOF
           $NOTES
           EOF
           else
@@ -155,7 +155,7 @@ jobs:
               --title "Upcoming Changes 🍿" \
               --notes-file - \
               --draft \
-              --target "$TARGET_SHA" <<'EOF'
+              --target "$TARGET_SHA" <<EOF
           $NOTES
           EOF
           fi
-- 
2.39.2

