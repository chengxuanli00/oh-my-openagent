 src/agents/builtin-agents.ts                  | 5 ++++-
 src/agents/builtin-agents/atlas-agent.ts      | 1 +
 src/agents/builtin-agents/general-agents.ts   | 1 +
 src/agents/builtin-agents/hephaestus-agent.ts | 5 ++++-
 src/agents/builtin-agents/sisyphus-agent.ts   | 5 ++++-
 src/plugin-handlers/agent-config-handler.ts   | 3 ++-
 6 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/src/agents/builtin-agents.ts b/src/agents/builtin-agents.ts
index 0a0a3ffb..3f19dbb0 100644
