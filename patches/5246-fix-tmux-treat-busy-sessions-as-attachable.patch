From e90ff8058e5f614d6ce9b7009405d9ea2765b41c Mon Sep 17 00:00:00 2001
From: Momentum96 <wjsrjsdn12@gmail.com>
Date: Fri, 8 May 2026 00:31:59 +0900
Subject: [PATCH 5246/5749] fix(tmux): treat busy sessions as attachable

---
 .../attachable-session-status.test.ts          | 18 ++++++++++++++++++
 .../tmux-subagent/attachable-session-status.ts |  2 +-
 2 files changed, 19 insertions(+), 1 deletion(-)
 create mode 100644 src/features/tmux-subagent/attachable-session-status.test.ts

diff --git a/src/features/tmux-subagent/attachable-session-status.test.ts b/src/features/tmux-subagent/attachable-session-status.test.ts
new file mode 100644
index 00000000..6ff1ce9a
--- /dev/null
+++ b/src/features/tmux-subagent/attachable-session-status.test.ts
@@ -0,0 +1,18 @@
+/// <reference types="bun-types" />
+
+import { describe, expect, test } from "bun:test"
+
+import { isAttachableSessionStatus } from "./attachable-session-status"
+
+describe("isAttachableSessionStatus", () => {
+  test("#given a busy session #when checking attachability #then it is attachable", () => {
+    //#given
+    const status = "busy"
+
+    //#when
+    const attachable = isAttachableSessionStatus(status)
+
+    //#then
+    expect(attachable).toBe(true)
+  })
+})
diff --git a/src/features/tmux-subagent/attachable-session-status.ts b/src/features/tmux-subagent/attachable-session-status.ts
index 22dc8977..f525e5e0 100644
--- a/src/features/tmux-subagent/attachable-session-status.ts
+++ b/src/features/tmux-subagent/attachable-session-status.ts
@@ -1,4 +1,4 @@
-const ATTACHABLE_SESSION_STATUSES = ["idle", "running"] as const
+const ATTACHABLE_SESSION_STATUSES = ["idle", "running", "busy"] as const
 
 export type AttachableSessionStatus = (typeof ATTACHABLE_SESSION_STATUSES)[number]
 
-- 
2.39.2

