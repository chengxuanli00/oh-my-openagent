 .../call-omo-agent/sync-executor.test.ts      | 61 ++++++++++++++++++-
 src/tools/call-omo-agent/sync-executor.ts     | 48 +++++++++++----
 2 files changed, 96 insertions(+), 13 deletions(-)

diff --git a/src/tools/call-omo-agent/sync-executor.test.ts b/src/tools/call-omo-agent/sync-executor.test.ts
