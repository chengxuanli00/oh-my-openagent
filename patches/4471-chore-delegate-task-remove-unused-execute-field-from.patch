index affd8198..1eb76796 100644
--- a/src/tools/delegate-task/types.ts
+++ b/src/tools/delegate-task/types.ts
@@ -19,10 +19,6 @@ export interface DelegateTaskArgs {
   task_id?: string
   command?: string
