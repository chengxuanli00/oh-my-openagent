From f260d15632b1e9abd3ddee5917d140dc24386517 Mon Sep 17 00:00:00 2001
From: YeonGyu-Kim <code.yeon.gyu@gmail.com>
Date: Sat, 21 Feb 2026 04:10:27 +0900
Subject: [PATCH 2543/5749] fix(auto-update): support prerelease versions
 without numeric suffix in fallback

---
 src/cli/config-manager/plugin-name-with-version.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/cli/config-manager/plugin-name-with-version.ts b/src/cli/config-manager/plugin-name-with-version.ts
index 7bffce84..501ccafb 100644
--- a/src/cli/config-manager/plugin-name-with-version.ts
+++ b/src/cli/config-manager/plugin-name-with-version.ts
@@ -4,7 +4,7 @@ const PACKAGE_NAME = "oh-my-opencode"
 const PRIORITIZED_TAGS = ["latest", "beta", "next"] as const
 
 function getFallbackEntry(version: string): string {
-  const prereleaseMatch = version.match(/-([a-zA-Z][a-zA-Z0-9]*)\./)
+  const prereleaseMatch = version.match(/-([a-zA-Z][a-zA-Z0-9-]*)(?:\.|$)/)
   if (prereleaseMatch) {
     return `${PACKAGE_NAME}@${prereleaseMatch[1]}`
   }
