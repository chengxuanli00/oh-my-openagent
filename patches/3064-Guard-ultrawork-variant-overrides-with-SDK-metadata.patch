+            high: {},
+          },
+        },
+      },
+    })
+    const dbOverrideSpy = spyOn(dbOverrideModule, "scheduleDeferredModelOverride").mockImplementation(() => {})
+
+    const config = {
+      agents: {
+        sisyphus: {
