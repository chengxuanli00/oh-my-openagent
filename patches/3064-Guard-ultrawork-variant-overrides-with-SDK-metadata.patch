+        },
+      },
+    } as Parameters<typeof applyUltraworkModelOverrideOnMessage>[0]
+
+    const output = {
+      message: {
+        model: { providerID: "anthropic", modelID: "claude-sonnet-4-6" },
+      } as Record<string, unknown>,
+      parts: [{ type: "text", text: "ultrawork do something" }],
+    }
+
+    // when
