-function getLastUserMessageBefore(
-  messages: SessionMessage[],
-  lastAssistantIndex: number,
-): SessionMessage | null {
-  for (let index = lastAssistantIndex - 1; index >= 0; index--) {
-    if (messages[index].info?.role === "user") {
