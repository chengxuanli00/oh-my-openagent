-      log(`[${HOOK_NAME}] Skipped: prompt already in flight`, { sessionID })
-      return
-    }
-
-    try {
-      const messagesResponse = await ctx.client.session.messages({
-        path: { id: sessionID },
-        query: { directory: ctx.directory },
