From 4dadd51fe74ab0a87b9495c67d99cbd4e4a5a755 Mon Sep 17 00:00:00 2001
From: YeonGyu-Kim <code.yeon.gyu@gmail.com>
Date: Fri, 5 Dec 2025 03:11:52 +0900
Subject: [PATCH 0042/5749] fix: upgrade to node 24 and npm@latest for OIDC
 trusted publishing (requires npm 11.5.1+)

---
 .github/workflows/publish.yml | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/publish.yml b/.github/workflows/publish.yml
index 67cd4572..35fe95d9 100644
--- a/.github/workflows/publish.yml
+++ b/.github/workflows/publish.yml
@@ -39,7 +39,10 @@ jobs:
 
       - uses: actions/setup-node@v4
         with:
-          node-version: "20"
+          node-version: "24"
+
+      - name: Upgrade npm for OIDC trusted publishing
+        run: npm install -g npm@latest
 
       - name: Configure npm registry
         run: npm config set registry https://registry.npmjs.org
-- 
2.39.2

