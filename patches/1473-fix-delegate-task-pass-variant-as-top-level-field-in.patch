Date: Tue, 27 Jan 2026 17:54:58 +0900
Subject: [PATCH 1473/5749] fix(delegate-task): pass variant as top-level field
 in prompt body

Ultraworked with [Sisyphus](https://github.com/code-yeongyu/oh-my-opencode)

Co-authored-by: Sisyphus <clio-agent@sisyphuslabs.ai>
---
 src/tools/delegate-task/tools.ts | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/tools/delegate-task/tools.ts b/src/tools/delegate-task/tools.ts
index 0da36ae4..7b0b52d7 100644
--- a/src/tools/delegate-task/tools.ts
+++ b/src/tools/delegate-task/tools.ts
@@ -936,7 +936,8 @@ To continue this session: session_id="${task.sessionID}"`
                 question: false,
               },
               parts: [{ type: "text", text: args.prompt }],
-              ...(categoryModel ? { model: categoryModel } : {}),
+              ...(categoryModel ? { model: { providerID: categoryModel.providerID, modelID: categoryModel.modelID } } : {}),
+              ...(categoryModel?.variant ? { variant: categoryModel.variant } : {}),
             },
           })
         } catch (promptError) {
