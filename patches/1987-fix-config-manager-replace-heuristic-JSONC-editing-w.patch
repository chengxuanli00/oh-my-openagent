diff --git a/src/cli/config-manager/jsonc-provider-editor.ts b/src/cli/config-manager/jsonc-provider-editor.ts
new file mode 100644
index 00000000..3f53c6d1
--- /dev/null
+++ b/src/cli/config-manager/jsonc-provider-editor.ts
@@ -0,0 +1,11 @@
+import { modify, applyEdits } from "jsonc-parser"
+
+export function modifyProviderInJsonc(
+  content: string,
+  newProviderValue: Record<string, unknown>
+): string {
+  const edits = modify(content, ["provider"], newProviderValue, {
+    formattingOptions: { tabSize: 2, insertSpaces: true },
+  })
+  return applyEdits(content, edits)
+}
