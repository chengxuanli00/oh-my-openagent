+## 2. MODIFY: `src/mcp/types.ts`
+
+```typescript
+import { z } from "zod"
+
+export const McpNameSchema = z.enum(["websearch", "context7", "grep_app", "arxiv"])
+
+export type McpName = z.infer<typeof McpNameSchema>
+
+export const AnyMcpNameSchema = z.string().min(1)
+
