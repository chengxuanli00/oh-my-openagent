+
+    // then
+    expect(max).toBe(10)
+  })
+
+  test("should allow spawning when under global limit", () => {
+    // given
+    const config: BackgroundTaskConfig = { maxBackgroundAgents: 2 }
+    const manager = new ConcurrencyManager(config)
+
+    // when
