+        event: {
+          type: "message.part.updated",
+          properties: { sessionID: "session-123" },
+        },
+      })
+      await hook.event({
+        event: {
+          type: "session.idle",
+          properties: { sessionID: "session-123" },
+        },
+      })
+
+      // then
+      expect(promptCalls.length).toBe(2)
+      expect(hook.getState()?.iteration).toBe(3)
+    })
