+import type { OpenClawConfig } from "./types"
+import { normalizeReplyListenerConfig } from "./config"
+
+const SECURE_FILE_MODE = 0o600
+const MAX_LOG_SIZE_BYTES = 1 * 1024 * 1024
+const DAEMON_ENV_ALLOWLIST = [
+  "PATH",
+  "HOME",
+  "USERPROFILE",
+  "USER",
+  "USERNAME",
+  "LOGNAME",
+  "LANG",
+  "LC_ALL",
+  "LC_CTYPE",
