 .../git-worktree/parse-status-porcelain.ts     | 18 ++++--------------
 2 files changed, 6 insertions(+), 14 deletions(-)

diff --git a/src/shared/git-worktree/index.ts b/src/shared/git-worktree/index.ts
index 0bc363d0..ff084ca8 100644
--- a/src/shared/git-worktree/index.ts
