From d800fec6b1369e77d096be996a5437afddebdfbf Mon Sep 17 00:00:00 2001
From: Paolo Notaro <paolo.notaro@outlook.com>
Date: Tue, 5 May 2026 21:01:50 +0200
Subject: [PATCH 4702/5749] fix(runtime-fallback): prevent infinite loop when
 fallback model equals current model

---
 src/hooks/runtime-fallback/fallback-state.ts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/hooks/runtime-fallback/fallback-state.ts b/src/hooks/runtime-fallback/fallback-state.ts
index 15348a21..bd0a3c43 100644
--- a/src/hooks/runtime-fallback/fallback-state.ts
+++ b/src/hooks/runtime-fallback/fallback-state.ts
@@ -28,6 +28,10 @@ export function findNextAvailableFallback(
 ): string | undefined {
   for (let i = state.fallbackIndex + 1; i < fallbackModels.length; i++) {
     const candidate = fallbackModels[i]
+    if (candidate === state.currentModel) {
+      log(`[${HOOK_NAME}] Skipping fallback model (same as current)`, { model: candidate, index: i })
+      continue
+    }
     if (!isModelInCooldown(candidate, state, cooldownSeconds)) {
       return candidate
     }
-- 
