From: YeonGyu-Kim <code.yeon.gyu@gmail.com>
Date: Mon, 29 Dec 2025 02:29:46 +0900
Subject: [PATCH 0653/5749] improve sanitize

---
 src/hooks/empty-message-sanitizer/index.ts | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/hooks/empty-message-sanitizer/index.ts b/src/hooks/empty-message-sanitizer/index.ts
index c15829f9..913bf500 100644
--- a/src/hooks/empty-message-sanitizer/index.ts
+++ b/src/hooks/empty-message-sanitizer/index.ts
@@ -42,8 +42,13 @@ export function createEmptyMessageSanitizerHook(): MessagesTransformHook {
     "experimental.chat.messages.transform": async (_input, output) => {
       const { messages } = output
 
-      for (const message of messages) {
-        if (message.info.role === "user") continue
+      for (let i = 0; i < messages.length; i++) {
+        const message = messages[i]
+        const isLastMessage = i === messages.length - 1
+        const isAssistant = message.info.role === "assistant"
+        
+        // Skip final assistant message (allowed to be empty per API spec)
+        if (isLastMessage && isAssistant) continue
 
         const parts = message.parts
 
