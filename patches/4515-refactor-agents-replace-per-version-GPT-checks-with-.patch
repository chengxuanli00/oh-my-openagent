     expect(isGptNativeSisyphusModel("openai/gpt-5.4")).toBe(true);
     expect(isGptNativeSisyphusModel("openai/gpt-5-4")).toBe(true);
     expect(isGptNativeSisyphusModel("openai/gpt-5.5")).toBe(true);
     expect(isGptNativeSisyphusModel("openai/gpt-5-5")).toBe(true);
