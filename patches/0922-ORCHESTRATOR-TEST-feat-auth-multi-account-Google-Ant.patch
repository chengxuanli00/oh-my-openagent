+
+      // #then - should fall back to 0
+      const current = manager.getCurrentAccount()
+      expect(current?.email).toBe("user1@example.com")
+    })
+  })
+})
diff --git a/src/auth/antigravity/accounts.ts b/src/auth/antigravity/accounts.ts
