 src/cli/doctor/checks/version.ts   | 4 +++-
 src/cli/get-local-version/index.ts | 4 +++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/cli/doctor/checks/version.ts b/src/cli/doctor/checks/version.ts
index 742463d7..0bde1393 100644
--- a/src/cli/doctor/checks/version.ts
+++ b/src/cli/doctor/checks/version.ts
@@ -50,7 +50,9 @@ export async function getVersionInfo(): Promise<VersionCheckInfo> {
   }
 
   const currentVersion = getCachedVersion()
-  const latestVersion = await getLatestVersion()
+  const { extractChannel } = await import("../../../hooks/auto-update-checker/index")
