         "@ast-grep/napi": "^0.40.0",
         "@code-yeongyu/comment-checker": "^0.5.0",
+        "@openauthjs/openauth": "^0.4.3",
         "@opencode-ai/plugin": "^1.0.150",
-        "opencode-openai-codex-auth": "^4.1.0",
+        "hono": "^4.10.4",
         "picomatch": "^4.0.2",
         "xdg-basedir": "^5.1.0",
         "zod": "^4.1.8",
