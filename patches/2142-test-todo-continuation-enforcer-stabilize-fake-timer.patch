     expect(promptCalls).toHaveLength(2)
-  })
+  }, { timeout: 15000 })
 
   test("should keep injecting even when todos remain unchanged across cycles", async () => {
     //#given
@@ -534,26 +565,26 @@ describe("todo-continuation-enforcer", () => {
