 	}
 }
 
-export function getIsolatedSessionName(pid: number = process.pid): string {
-	return `${ISOLATED_SESSION_NAME_PREFIX}-${pid}`
+export function getIsolatedSessionName(pid: number = process.pid, managerId?: string): string {
+	return managerId
