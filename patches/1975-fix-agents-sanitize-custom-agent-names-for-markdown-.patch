From: YeonGyu-Kim <code.yeon.gyu@gmail.com>
Date: Mon, 9 Feb 2026 12:00:01 +0900
Subject: [PATCH 1975/5749] fix(agents): sanitize custom agent names for
 markdown table safety

---
 src/agents/custom-agent-summaries.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/agents/custom-agent-summaries.ts b/src/agents/custom-agent-summaries.ts
index bdcb7b68..42418b01 100644
--- a/src/agents/custom-agent-summaries.ts
+++ b/src/agents/custom-agent-summaries.ts
@@ -38,7 +38,7 @@ export function parseRegisteredAgentSummaries(input: unknown): RegisteredAgentSu
     if (enabled === false) continue
 
     const description = typeof item.description === "string" ? item.description : ""
-    result.push({ name, description: sanitizeMarkdownTableCell(description) })
+    result.push({ name: sanitizeMarkdownTableCell(name), description: sanitizeMarkdownTableCell(description) })
   }
 
   return result
