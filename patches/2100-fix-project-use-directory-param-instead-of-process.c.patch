 src/features/claude-code-agent-loader/loader.ts   |  4 ++--
 src/features/claude-code-command-loader/loader.ts | 14 +++++++-------
 src/plugin-handlers/agent-config-handler.ts       |  2 +-
 src/plugin-handlers/command-config-handler.ts     |  8 ++++----
 src/plugin/tool-registry.ts                       |  2 +-
 src/tools/slashcommand/command-discovery.ts       |  6 +++---
 6 files changed, 18 insertions(+), 18 deletions(-)

