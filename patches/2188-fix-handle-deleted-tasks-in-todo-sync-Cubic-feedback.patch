From 02e05346157bfbb43b5b9cd2517780106042f9f7 Mon Sep 17 00:00:00 2001
From: YeonGyu-Kim <code.yeon.gyu@gmail.com>
Date: Sat, 14 Feb 2026 19:02:30 +0900
Subject: [PATCH 2188/5749] fix: handle deleted tasks in todo-sync (Cubic
 feedback)

- When task is deleted (syncTaskToTodo returns null), filter by content

- Prevents stale todos from remaining after task deletion
---
 src/tools/task/todo-sync.ts | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/tools/task/todo-sync.ts b/src/tools/task/todo-sync.ts
index 8a06ce52..0a4d32d1 100644
--- a/src/tools/task/todo-sync.ts
+++ b/src/tools/task/todo-sync.ts
@@ -108,7 +108,11 @@ export async function syncTaskTodoUpdate(
     });
     const currentTodos = extractTodos(response);
     const taskTodo = syncTaskToTodo(task);
-    const nextTodos = currentTodos.filter((todo) => !taskTodo || !todosMatch(todo, taskTodo));
+    const nextTodos = currentTodos.filter((todo) =>
+      taskTodo
+        ? !todosMatch(todo, taskTodo)
+        : todo.content !== task.subject
+    );
     const todo = taskTodo;
 
     if (todo) {
