 src/hooks/atlas/index.test.ts             | 14 +++++++-------
 src/hooks/atlas/index.ts                  |  2 +-
 src/hooks/start-work/index.test.ts        |  2 +-
 src/hooks/start-work/index.ts             |  2 +-
 5 files changed, 11 insertions(+), 11 deletions(-)

diff --git a/src/features/builtin-commands/commands.ts b/src/features/builtin-commands/commands.ts
index 053c3eed..d4e10903 100644
--- a/src/features/builtin-commands/commands.ts
+++ b/src/features/builtin-commands/commands.ts
@@ -55,7 +55,7 @@ ${REFACTOR_TEMPLATE}
   },
   "start-work": {
     description: "(builtin) Start Sisyphus work session from Prometheus plan",
-    agent: "Atlas",
+    agent: "atlas",
     template: `<command-instruction>
 ${START_WORK_TEMPLATE}
 </command-instruction>
