       expect(observed[0]?.bootstrap?.tools?.question).toBe(false)
       expect(observed[0]?.bootstrap?.fallbackChain?.[0]?.model).toBe("gpt-5.4")
       expect(getDelegatedChildSessionBootstrap("ses-call-bootstrap")).toBeUndefined()
