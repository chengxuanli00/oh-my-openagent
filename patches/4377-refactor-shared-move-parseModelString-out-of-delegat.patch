 src/shared/index.ts                                        | 1 +
 src/{tools/delegate-task => shared}/model-string-parser.ts | 0
 src/tools/call-omo-agent/tools.ts                          | 4 ++--
 src/tools/delegate-task/category-resolver.ts               | 2 +-
 src/tools/delegate-task/model-selection.ts                 | 2 +-
 6 files changed, 6 insertions(+), 5 deletions(-)
 rename src/{tools/delegate-task => shared}/model-string-parser.ts (100%)

