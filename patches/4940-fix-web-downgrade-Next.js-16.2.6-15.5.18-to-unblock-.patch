 web/bun.lock          | 100 ++++++++----------------------------------
 web/eslint.config.mjs |   2 +-
 web/package.json      |   4 +-
 web/tsconfig.json     |   3 +-
 4 files changed, 23 insertions(+), 86 deletions(-)

