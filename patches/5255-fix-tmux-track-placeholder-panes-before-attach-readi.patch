 src/features/tmux-subagent/polling-manager.ts |  26 +++-
 .../tmux-subagent/tracked-session-state.ts    |   1 +
 src/features/tmux-subagent/types.ts           |   1 +
 src/shared/tmux/tmux-utils/session-spawn.ts   |  11 +-
