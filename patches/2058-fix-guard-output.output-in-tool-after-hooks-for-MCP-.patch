 src/hooks/task-resume-info/hook.ts          |   9 +-
 src/hooks/task-resume-info/index.test.ts    | 101 ++++++++++++++++++++
 5 files changed, 125 insertions(+), 6 deletions(-)
 create mode 100644 src/hooks/task-resume-info/index.test.ts

