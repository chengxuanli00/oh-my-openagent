From: Netzhangheng <25896014+Netzhangheng@users.noreply.github.com>
Date: Sat, 18 Apr 2026 12:35:27 +0800
Subject: [PATCH 4394/5749] Fix interceptor auth injection binding

---
 src/shared/opencode-server-auth.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/shared/opencode-server-auth.ts b/src/shared/opencode-server-auth.ts
index 11e4d542..02ebfa92 100644
--- a/src/shared/opencode-server-auth.ts
+++ b/src/shared/opencode-server-auth.ts
@@ -78,7 +78,7 @@ function tryInjectViaInterceptors(internal: UnknownRecord, auth: string): boolea
     return false
   }
 
-  requestInterceptors.use((request: Request): Request => {
+  use.call(requestInterceptors, (request: Request): Request => {
     if (!request.headers.get("Authorization")) {
       request.headers.set("Authorization", auth)
     }
