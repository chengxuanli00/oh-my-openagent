+    const firstThreeOutputs = [1, 2, 3].map((index) => ({
+      title: `Final review ${index}`,
+      output: `Reviewer ${index} | VERDICT: APPROVE
+
+<task_metadata>
+session_id: ses_parallel_review_${index}
+</task_metadata>`,
