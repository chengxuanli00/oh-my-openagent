+    const lastOutput = {
+      title: "Final review 4",
+      output: `Reviewer 4 | VERDICT: APPROVE
+
+<task_metadata>
+session_id: ses_parallel_review_4
+</task_metadata>`,
+      metadata: {},
+    }
