+): void {
+  _bunSqliteImporter = impl
+}
+
+/** @internal test-only */
+export function __resetBunSqliteImporterForTesting(): void {
+  _bunSqliteImporter = () => import("bun:sqlite").catch(() => null) as Promise<SqliteModule | null>
+}
