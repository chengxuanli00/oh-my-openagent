 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/hooks/non-interactive-env/non-interactive-env-hook.ts b/src/hooks/non-interactive-env/non-interactive-env-hook.ts
index 46ab2e09..758a1eb7 100644
