+
+      // #when detectExistingConfigDir is called
+      const result = detectExistingConfigDir("opencode", "1.0.200")
+
+      // #then result is either null or a valid string path
+      expect(result === null || typeof result === "string").toBe(true)
+    })
+  })
+})
