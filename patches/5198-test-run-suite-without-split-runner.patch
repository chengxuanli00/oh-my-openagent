-    : selectShard(ciTestPlan.isolatedTestTargets, options.shardCount, options.shardIndex)
-  const sharedTestFiles = options.phase === "isolated" ? [] : ciTestPlan.sharedTestFiles
-
-  return { isolatedTestTargets, sharedTestFiles }
-}
