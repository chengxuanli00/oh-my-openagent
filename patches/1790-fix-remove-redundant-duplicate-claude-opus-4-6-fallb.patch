     expect(primary.variant).toBe("max")
 
-    const secondary = sisyphus.fallbackChain[1]
-    expect(secondary.providers[0]).toBe("anthropic")
-    expect(secondary.model).toBe("claude-opus-4-6")
-    expect(secondary.variant).toBe("max")
-
