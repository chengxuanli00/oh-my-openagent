+                 parts: [{ type: "text", text: "Previous result" }],
+               },
+             ]
 
-            if (messagesCallCount === 1) {
-              return { data: beforeContinuation }
-            }
-
-            return {
-              data: [
-                ...beforeContinuation,
-                {
