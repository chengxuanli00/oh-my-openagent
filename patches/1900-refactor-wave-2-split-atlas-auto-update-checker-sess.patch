--- /dev/null
+++ b/src/hooks/auto-update-checker/checker/jsonc-strip.ts
@@ -0,0 +1,7 @@
+export function stripJsonComments(json: string): string {
+  return json
+    .replace(/\\"|"(?:\\"|[^"])*"|(\/\/.*|\/\*[\s\S]*?\*\/)/g, (match, group) =>
+      group ? "" : match
+    )
+    .replace(/,(\s*[}\]])/g, "$1")
+}
