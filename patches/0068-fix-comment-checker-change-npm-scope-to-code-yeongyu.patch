--- a/src/hooks/comment-checker/cli.ts
+++ b/src/hooks/comment-checker/cli.ts
@@ -21,20 +21,20 @@ function getPlatformPackageName(): string | null {
   const arch = process.arch
 
   const platformMap: Record<string, string> = {
