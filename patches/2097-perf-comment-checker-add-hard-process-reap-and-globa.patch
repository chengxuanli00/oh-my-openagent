 let cliPathPromise: Promise<string | null> | null = null
+let isRunning = false
+
+async function withCommentCheckerLock<T>(
+  fn: () => Promise<T>,
+  fallback: T,
+  debugLog: (...args: unknown[]) => void,
+): Promise<T> {
+  if (isRunning) {
+    debugLog("comment-checker already running, skipping")
+    return fallback
+  }
+  isRunning = true
+  try {
+    return await fn()
+  } finally {
+    isRunning = false
+  }
+}
 
