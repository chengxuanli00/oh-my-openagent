+  test("should contain /opsx:ff fast-forward command", () => {
+    //#given
+    const prompt = PROMETHEUS_SYSTEM_PROMPT
+
+    //#when / #then
+    expect(prompt).toContain("/opsx:ff")
+  })
+
+  test("should contain /opsx:explore command", () => {
+    //#given
+    const prompt = PROMETHEUS_SYSTEM_PROMPT
