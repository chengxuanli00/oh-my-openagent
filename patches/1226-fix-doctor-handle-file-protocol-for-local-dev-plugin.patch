From 45fe9578ec7494692819efe2cbfb13fcbfd2372b Mon Sep 17 00:00:00 2001
From: carlory <baofa.fan@daocloud.io>
Date: Mon, 19 Jan 2026 16:09:46 +0800
Subject: [PATCH 1226/5749] fix(doctor): handle file:// protocol for local dev
 plugin detection

---
 src/cli/doctor/checks/plugin.ts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/cli/doctor/checks/plugin.ts b/src/cli/doctor/checks/plugin.ts
index 5bfc063a..d7ed9d63 100644
--- a/src/cli/doctor/checks/plugin.ts
+++ b/src/cli/doctor/checks/plugin.ts
@@ -22,6 +22,9 @@ function findPluginEntry(plugins: string[]): { entry: string; isPinned: boolean;
       const version = isPinned ? plugin.split("@")[1] : null
       return { entry: plugin, isPinned, version }
     }
+    if (plugin.startsWith("file://") && plugin.includes(PACKAGE_NAME)) {
+      return { entry: plugin, isPinned: false, version: "local-dev" }
+    }
   }
   return null
 }
