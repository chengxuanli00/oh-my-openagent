From: YeonGyu-Kim <code.yeon.gyu@gmail.com>
Date: Fri, 19 Dec 2025 15:15:10 +0900
Subject: [PATCH 0462/5749] fix(non-interactive-env): add editor and pager
 environment variables to block interactive UI
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- GIT_EDITOR, EDITOR, VISUAL, GIT_SEQUENCE_EDITOR set to 'true' to block editor invocations during git operations like rebase
- GIT_PAGER, PAGER set to 'cat' to disable pagination
- Fixes issue where git rebase --continue was still opening nvim despite existing non-interactive env vars

🤖 GENERATED WITH ASSISTANCE OF [OhMyOpenCode](https://github.com/code-yeongyu/oh-my-opencode)
---
 src/hooks/non-interactive-env/constants.ts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/hooks/non-interactive-env/constants.ts b/src/hooks/non-interactive-env/constants.ts
index a0696d04..d9a5937f 100644
--- a/src/hooks/non-interactive-env/constants.ts
+++ b/src/hooks/non-interactive-env/constants.ts
@@ -6,4 +6,12 @@ export const NON_INTERACTIVE_ENV: Record<string, string> = {
   GIT_TERMINAL_PROMPT: "0",
   GCM_INTERACTIVE: "never",
   HOMEBREW_NO_AUTO_UPDATE: "1",
+  // Block interactive editors - git rebase, commit, etc.
+  GIT_EDITOR: "true",
+  EDITOR: "true",
+  VISUAL: "true",
+  GIT_SEQUENCE_EDITOR: "true",
+  // Block pagers
+  GIT_PAGER: "cat",
+  PAGER: "cat",
 }
