diff --git a/src/hooks/auto-update-checker/hook/deferred-idle-check.ts b/src/hooks/auto-update-checker/hook/deferred-idle-check.ts
new file mode 100644
index 00000000..a929cf4e
--- /dev/null
+++ b/src/hooks/auto-update-checker/hook/deferred-idle-check.ts
@@ -0,0 +1,4 @@
+export function scheduleDeferredIdleCheck(runCheck: () => void): void {
+  const timeout = setTimeout(runCheck, 5000)
+  timeout.unref?.()
+}
