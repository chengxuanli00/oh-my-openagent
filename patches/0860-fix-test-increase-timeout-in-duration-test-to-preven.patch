Date: Mon, 5 Jan 2026 20:20:46 +0900
Subject: [PATCH 0860/5749] fix(test): increase timeout in duration test to
 prevent flakiness (#508)

---
 src/cli/doctor/runner.test.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/cli/doctor/runner.test.ts b/src/cli/doctor/runner.test.ts
index b1c3fc82..dbd55bcb 100644
--- a/src/cli/doctor/runner.test.ts
+++ b/src/cli/doctor/runner.test.ts
@@ -30,7 +30,7 @@ describe("runner", () => {
         name: "Test Check",
         category: "installation",
         check: async () => {
-          await new Promise((r) => setTimeout(r, 10))
+          await new Promise((r) => setTimeout(r, 50))
           return { name: "Test", status: "pass", message: "OK" }
         },
       }
