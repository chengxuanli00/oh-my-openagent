+
+export function createInternalAgentContinuationTextPart(text: string): {
+  type: "text"
+  text: string
+  synthetic: true
+  metadata: { compaction_continue: true }
+} {
+  return {
+    ...createInternalAgentTextPart(text),
+    synthetic: true,
+    metadata: { compaction_continue: true },
+  }
