+describe("detectRegexMisuse", () => {
+  describe("#given pure regex alternation", () => {
+    it("#when pattern is lowercase alternation #then returns alternation hint", () => {
+      // given
+      const pattern = "watch|WatchMode|--watch"
+
+      // when
