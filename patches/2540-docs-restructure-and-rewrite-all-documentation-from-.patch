-      "model": "google/gemini-3-pro"
-    },
-    "ultrabrain": { 
-      "model": "openai/gpt-5.3-codex",
-      "variant": "xhigh"
-    },
-    "deep": {
-      "model": "openai/gpt-5.3-codex",
-      "variant": "medium"
-    },
-    "artistry": { 
-      "model": "google/gemini-3-pro",
-      "variant": "high"
-    },
-    "quick": { 
-      "model": "anthropic/claude-haiku-4-5"  // Fast + cheap for trivial tasks
-    },
-    "unspecified-low": { 
-      "model": "anthropic/claude-sonnet-4-6"
-    },
-    "unspecified-high": { 
-      "model": "anthropic/claude-opus-4-6",
-      "variant": "max"
