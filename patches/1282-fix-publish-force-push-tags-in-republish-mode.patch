From ba756d7533e36a812823923e74c66f89162d7c09 Mon Sep 17 00:00:00 2001
From: justsisyphus <justsisyphus@users.noreply.github.com>
Date: Thu, 22 Jan 2026 11:04:59 +0900
Subject: [PATCH 1282/5749] fix(publish): force push tags in republish mode

---
 .github/workflows/publish.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/publish.yml b/.github/workflows/publish.yml
index 20e222b6..c1138db5 100644
--- a/.github/workflows/publish.yml
+++ b/.github/workflows/publish.yml
@@ -162,7 +162,7 @@ jobs:
           git add package.json assets/oh-my-opencode.schema.json packages/*/package.json || true
           git diff --cached --quiet || git commit -m "release: v${{ steps.version.outputs.version }}"
           git tag -f "v${{ steps.version.outputs.version }}"
-          git push origin --tags
+          git push origin --tags --force
           git push origin HEAD || echo "Branch push failed (non-critical)"
         env:
           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
-- 
2.39.2

