Date: Fri, 5 Dec 2025 09:44:55 +0900
Subject: [PATCH 0056/5749] fix: resolve tree-sitter wasm initialization error
 with locateFile option

---
 src/hooks/comment-checker/detector.ts | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/hooks/comment-checker/detector.ts b/src/hooks/comment-checker/detector.ts
index 64e74ef0..cfbb01ef 100644
--- a/src/hooks/comment-checker/detector.ts
+++ b/src/hooks/comment-checker/detector.ts
@@ -47,7 +47,11 @@ export async function detectComments(
 
   try {
     const Parser = (await import("web-tree-sitter")).default
-    await Parser.init()
+    
+    const treeSitterWasmPath = require.resolve("web-tree-sitter/tree-sitter.wasm")
+    await Parser.init({
+      locateFile: () => treeSitterWasmPath,
+    })
 
     const parser = new Parser()
 
