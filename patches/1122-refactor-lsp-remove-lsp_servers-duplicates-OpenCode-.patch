   lsp_diagnostics,
-  lsp_servers,
   lsp_prepare_rename,
   lsp_rename,
   ast_grep_search,
diff --git a/src/tools/lsp/index.ts b/src/tools/lsp/index.ts
index 88b82656..bdf15aa1 100644
--- a/src/tools/lsp/index.ts
+++ b/src/tools/lsp/index.ts
