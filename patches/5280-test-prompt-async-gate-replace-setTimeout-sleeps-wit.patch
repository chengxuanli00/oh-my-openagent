+    const originalDateNow = Date.now
+    let currentNow = originalDateNow()
+    Date.now = () => currentNow
     const client = {
       session: {
         promptAsync: async () => {
@@ -130,29 +132,33 @@ describe("promptAsyncAfterSessionIdle", () => {
