 src/plugin-handlers/config-handler.test.ts | 17 ++++---
 src/tools/delegate-task/tools.test.ts      | 54 +++++++++++-----------
 src/tools/delegate-task/tools.ts           |  7 +--
 4 files changed, 45 insertions(+), 48 deletions(-)

