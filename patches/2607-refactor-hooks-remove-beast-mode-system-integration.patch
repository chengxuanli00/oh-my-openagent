-      const model = getSessionModel(input.sessionID)
-      if (!isBeastModeModel(model)) return
-
-      if (output.system.some((entry) => entry.includes("Beast Mode"))) return
-
-      output.system.unshift(BEAST_MODE_SYSTEM_PROMPT)
-    },
-  }
-}
