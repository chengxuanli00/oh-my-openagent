@@ -56,10 +63,15 @@ function buildPowerShellCommand(options: GlobOptions): string[] {
 
   let psCommand = `Get-ChildItem -Path '${escapedPath}' -File -Recurse -Depth ${maxDepth - 1} -Filter '${escapedPattern}'`
 
-  if (options.hidden) {
