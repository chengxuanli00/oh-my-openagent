-    return body
-  }
-
-  debugLog(`[TSIG][INJECT] Found ${contents.length} content blocks`)
-  let injectedCount = 0
-  const modifiedContents = contents.map((content) => {
-    if (!content.parts || !Array.isArray(content.parts)) {
