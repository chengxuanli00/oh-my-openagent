-    const executeWithEndpoints = async (): Promise<Response> => {
-      for (let i = 0; i < maxEndpoints; i++) {
-        const endpoint = ANTIGRAVITY_ENDPOINT_FALLBACKS[i]
-
-        const response = await attemptFetch({
-          endpoint,
-          url,
-          init,
-          accessToken: cachedTokens!.access_token,
-          projectId,
-          sessionId,
