-/**
- * Debug logging helper
- * Only logs when ANTIGRAVITY_DEBUG=1
- */
-function debugLog(message: string): void {
-  if (process.env.ANTIGRAVITY_DEBUG === "1") {
-    console.log(`[antigravity-fetch] ${message}`)
-  }
