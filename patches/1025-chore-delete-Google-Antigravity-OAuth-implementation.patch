-  // Check for -high suffix (primary indicator of thinking capability)
-  if (lowerModel.endsWith("-high")) {
-    return true
-  }
-
-  // Also check for explicit thinking in model name
-  if (lowerModel.includes("thinking")) {
-    return true
-  }
-
-  return false
-}
