 .../claude-code-plugin-loader/discovery.test.ts      |  6 +++---
 src/features/claude-code-plugin-loader/discovery.ts  | 12 +++++++-----
 src/features/claude-code-plugin-loader/types.ts      |  6 ++++++
 3 files changed, 16 insertions(+), 8 deletions(-)

