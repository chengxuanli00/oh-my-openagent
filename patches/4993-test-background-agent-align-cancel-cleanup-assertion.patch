---
 src/features/background-agent/cancel-task-cleanup.test.ts | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/features/background-agent/cancel-task-cleanup.test.ts b/src/features/background-agent/cancel-task-cleanup.test.ts
index d8e43f95..19bb0335 100644
--- a/src/features/background-agent/cancel-task-cleanup.test.ts
