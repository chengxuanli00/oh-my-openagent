From 3dce19d173b150ced1ea000c59ef517f8202f4dd Mon Sep 17 00:00:00 2001
From: YeonGyu-Kim <code.yeon.gyu@gmail.com>
Date: Sat, 18 Apr 2026 20:27:48 +0900
Subject: [PATCH 4456/5749] fix(tmux-subagent): move 'cleanup complete' log
 back to cleanup() method

The log line was misplaced at the end of sweepStaleIsolatedSessionsOnce
where it said 'cleanup complete' after the stale sweep, which was
misleading. Per Oracle review.
---
 src/features/tmux-subagent/manager.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/features/tmux-subagent/manager.ts b/src/features/tmux-subagent/manager.ts
index 1091033e..7b9d92d8 100644
--- a/src/features/tmux-subagent/manager.ts
+++ b/src/features/tmux-subagent/manager.ts
@@ -989,6 +989,8 @@ export class TmuxSessionManager {
     }
 
     this.staleSweepCompleted = false
+
+    log("[tmux-session-manager] cleanup complete")
   }
 
   private async sweepStaleIsolatedSessionsOnce(): Promise<void> {
@@ -1009,7 +1011,5 @@ export class TmuxSessionManager {
         error: String(error),
       })
     }
-
-    log("[tmux-session-manager] cleanup complete")
   }
 }
-- 
2.39.2

