+      waitForCompletion: mock(async () => {}),
+      processMessages: mock(async () => "agent response"),
+    }
+
     let promptArgs: any
     const promptAsync = mock(async (input: any) => {
       promptArgs = input
@@ -44,7 +38,7 @@ describe("executeSync", () => {
     }
 
