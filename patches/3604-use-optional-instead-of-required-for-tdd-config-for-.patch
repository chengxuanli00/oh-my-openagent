From e9e0aef84713585635fda95958477ac2867aaddd Mon Sep 17 00:00:00 2001
From: Ryan Dielhenn <dielhennr@gmail.com>
Date: Sat, 28 Mar 2026 11:10:26 -0700
Subject: [PATCH 3604/5749] use optional instead of required for tdd config for
 backwards compatibility

---
 assets/oh-my-opencode.schema.json   | 3 ---
 src/config/schema/sisyphus-agent.ts | 2 +-
 2 files changed, 1 insertion(+), 4 deletions(-)

diff --git a/assets/oh-my-opencode.schema.json b/assets/oh-my-opencode.schema.json
index 7ab3a9d0..3cdf6b6c 100644
--- a/assets/oh-my-opencode.schema.json
+++ b/assets/oh-my-opencode.schema.json
@@ -4267,9 +4267,6 @@
           "type": "boolean"
         }
       },
-      "required": [
-        "tdd"
-      ],
       "additionalProperties": false
     },
     "comment_checker": {
diff --git a/src/config/schema/sisyphus-agent.ts b/src/config/schema/sisyphus-agent.ts
index 6b15b118..be08dda8 100644
--- a/src/config/schema/sisyphus-agent.ts
+++ b/src/config/schema/sisyphus-agent.ts
@@ -5,7 +5,7 @@ export const SisyphusAgentConfigSchema = z.object({
   default_builder_enabled: z.boolean().optional(),
   planner_enabled: z.boolean().optional(),
   replace_plan: z.boolean().optional(),
-  tdd: z.boolean().default(true),
+  tdd: z.boolean().default(true).optional(),
 })
 
 export type SisyphusAgentConfig = z.infer<typeof SisyphusAgentConfigSchema>
-- 
