 src/features/background-agent/concurrency.ts  |  91 +++++++-
 src/features/background-agent/manager.test.ts | 176 ++++++++++++++
 src/features/background-agent/manager.ts      | 219 +++++++++++++-----
 4 files changed, 482 insertions(+), 71 deletions(-)

