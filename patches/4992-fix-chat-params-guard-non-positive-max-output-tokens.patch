+++ b/src/shared/model-settings-compatibility.ts
@@ -162,6 +162,10 @@ export function resolveCompatibleModelSettings(
   }
 
   let maxTokens = input.desired.maxTokens
+  if (maxTokens !== undefined && maxTokens <= 0) {
