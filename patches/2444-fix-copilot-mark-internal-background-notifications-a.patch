diff --git a/src/shared/internal-initiator-marker.ts b/src/shared/internal-initiator-marker.ts
new file mode 100644
index 00000000..cc0b1001
--- /dev/null
+++ b/src/shared/internal-initiator-marker.ts
@@ -0,0 +1,13 @@
+export const OMO_INTERNAL_INITIATOR_MARKER = "<!-- OMO_INTERNAL_INITIATOR -->"
+
+export function createInternalAgentTextPart(text: string): {
+  type: "text"
+  text: string
+  synthetic: true
+} {
+  return {
+    type: "text",
+    text: `${text}\n${OMO_INTERNAL_INITIATOR_MARKER}`,
+    synthetic: true,
+  }
+}
