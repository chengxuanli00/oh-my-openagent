 delete mode 100644 packages/web/app/opengraph-image.tsx
 create mode 100644 packages/web/app/twitter-image.png
 delete mode 100644 packages/web/app/twitter-image.tsx

diff --git a/packages/web/app/opengraph-image.png b/packages/web/app/opengraph-image.png
new file mode 100644
