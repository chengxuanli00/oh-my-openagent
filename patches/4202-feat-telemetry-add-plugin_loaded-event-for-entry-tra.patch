From 4e80a1b1aeb941814316a4415092d7c5a44596a0 Mon Sep 17 00:00:00 2001
From: YeonGyu-Kim <code.yeon.gyu@gmail.com>
Date: Sat, 11 Apr 2026 14:14:28 +0900
Subject: [PATCH 4202/5749] feat(telemetry): add plugin_loaded event for entry
 tracking

---
 src/index.ts | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/index.ts b/src/index.ts
index d0c8050c..24584629 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -40,10 +40,13 @@ const OhMyOpenCodePlugin: Plugin = async (ctx) => {
   const pluginConfig = loadPluginConfig(ctx.directory, ctx)
 
   const posthog = createPluginPostHog()
+  const distinctId = getPostHogDistinctId()
+  posthog.trackActive(distinctId, "plugin_loaded")
   posthog.capture({
-    distinctId: getPostHogDistinctId(),
+    distinctId,
     event: "plugin_loaded",
     properties: {
+      entry_point: "plugin",
       has_openclaw: !!pluginConfig.openclaw,
       tmux_enabled: isTmuxIntegrationEnabled(pluginConfig),
     },
-- 
