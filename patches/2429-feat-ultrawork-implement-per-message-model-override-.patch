+    scheduleDeferredModelOverride(
+      "msg_004",
+      { providerID: "anthropic", modelID: "claude-opus-4-6" },
+    )
+    await flushMicrotasks(5)
+
+    //#then
+    expect(logSpy).toHaveBeenCalledWith(
+      expect.stringContaining("DB not found"),
+    )
+  })
+})
