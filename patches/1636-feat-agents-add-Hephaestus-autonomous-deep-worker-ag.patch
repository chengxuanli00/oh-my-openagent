+			return fuzzyMatchModel(entry.model, availableModels, [provider]) !== null
+		})
+		if (hasAvailableProvider) {
+			return true
+		}
+	}
+	log("[isAnyFallbackModelAvailable] no model available in chain", { chainLength: fallbackChain.length })
+	return false
