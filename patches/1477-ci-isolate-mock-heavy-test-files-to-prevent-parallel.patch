From 897eea0263c9a5f576724318e36df2eb10b25c04 Mon Sep 17 00:00:00 2001
From: justsisyphus <justsisyphus@users.noreply.github.com>
Date: Wed, 28 Jan 2026 01:00:17 +0900
Subject: [PATCH 1477/5749] ci: isolate mock-heavy test files to prevent
 parallel pollution

---
 .github/workflows/publish.yml | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/publish.yml b/.github/workflows/publish.yml
index 104d3b64..f137cde7 100644
--- a/.github/workflows/publish.yml
+++ b/.github/workflows/publish.yml
@@ -46,7 +46,12 @@ jobs:
           BUN_INSTALL_ALLOW_SCRIPTS: "@ast-grep/napi"
 
       - name: Run tests
-        run: bun test
+        run: |
+          # Run tests that use mock.module() separately to avoid pollution
+          bun test src/plugin-handlers/config-handler.test.ts
+          bun test src/hooks/compaction-context-injector/index.test.ts
+          # Run all other tests (excluding already-run mock-heavy files)
+          bun test --ignore '**/config-handler.test.ts' --ignore '**/compaction-context-injector/index.test.ts'
 
   typecheck:
     runs-on: ubuntu-latest
-- 
2.39.2

