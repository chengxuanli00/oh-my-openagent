 src/agents/sisyphus-junior.ts         | 12 +++++++-----
 src/plugin-handlers/config-handler.ts |  9 ---------
 src/tools/call-omo-agent/tools.ts     |  1 -
 4 files changed, 17 insertions(+), 23 deletions(-)

