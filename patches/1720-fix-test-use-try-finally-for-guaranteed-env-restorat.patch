From 9a2a6a695a376d6031a3e20e805a2b35ceba8690 Mon Sep 17 00:00:00 2001
From: YanzheL <lee.yanzhe@yanzhe.org>
Date: Mon, 2 Feb 2026 04:00:06 +0800
Subject: [PATCH 1720/5749] fix(test): use try/finally for guaranteed env
 restoration

---
 src/mcp/index.test.ts | 20 +++++++++++---------
 1 file changed, 11 insertions(+), 9 deletions(-)

diff --git a/src/mcp/index.test.ts b/src/mcp/index.test.ts
index 178caf19..b1831ecd 100644
--- a/src/mcp/index.test.ts
+++ b/src/mcp/index.test.ts
@@ -91,14 +91,16 @@ describe("createBuiltinMcps", () => {
     const disabledMcps = ["websearch"]
     const config = { websearch: { provider: "tavily" as const } }
 
-    // when
-    const createMcps = () => createBuiltinMcps(disabledMcps, config)
-
-    // then
-    expect(createMcps).not.toThrow()
-    const result = createMcps()
-    expect(result).not.toHaveProperty("websearch")
-
-    if (originalTavilyKey) process.env.TAVILY_API_KEY = originalTavilyKey
+    try {
+      // when
+      const createMcps = () => createBuiltinMcps(disabledMcps, config)
+
+      // then
+      expect(createMcps).not.toThrow()
+      const result = createMcps()
+      expect(result).not.toHaveProperty("websearch")
+    } finally {
+      if (originalTavilyKey) process.env.TAVILY_API_KEY = originalTavilyKey
+    }
   })
 })
