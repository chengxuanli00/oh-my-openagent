-export function executeSupersedeWrites(
-  sessionID: string,
-  state: PruningState,
-  config: SupersedeWritesConfig,
-  protectedTools: Set<string>
-): number {
-  if (!config.enabled) return 0
-
-  const messages = readMessages(sessionID)
