index 0ba99ce9..f7d1087f 100644
--- a/src/agents/hephaestus/agent.test.ts
+++ b/src/agents/hephaestus/agent.test.ts
@@ -23,7 +23,7 @@ describe("getHephaestusPromptSource", () => {
