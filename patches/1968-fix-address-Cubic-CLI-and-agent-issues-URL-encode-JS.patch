@@ -15,7 +15,11 @@ const execFileSyncMock = mock((file: string, args: string[], _opts: { cwd?: stri
   }
 
   if (subcommand === "status") {
-    return " M file.ts\n"
+    return " M file.ts\n?? new-file.ts\n"
+  }
+
+  if (subcommand === "ls-files") {
